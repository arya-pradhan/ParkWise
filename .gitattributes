* text=auto

# Never let line-ending normalization touch binaries. A CRLF-mangled .onnx
# fails in the browser with an opaque parse error, so be explicit rather than
# relying on git's binary auto-detection.
*.onnx   binary
*.pt     binary
*.bin    binary
*.jpg    binary
*.jpeg   binary
*.png    binary
*.webm   binary
*.mp4    binary
*.wasm   binary
*.woff2  binary

# Shell scripts must keep LF or they fail inside Linux containers with
# "$'\r': command not found" — the exact bug the 2022 README documented.
*.sh          text eol=lf
entrypoint.sh text eol=lf
