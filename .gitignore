# ── Node / Next.js ────────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
.vercel/
*.tsbuildinfo
next-env.d.ts
.env
.env.*
!.env.example
npm-debug.log*
yarn-error.log*
.eslintcache
personal_pic_test

# Copied out of node_modules by scripts/copy-ort-assets.mjs on pre{dev,build}.
# Regenerated every install — never commit it.
/public/ort/

# ── Model artifacts ───────────────────────────────────────────────────────
# models/best.pt IS committed: it is the source of truth for every export, and
# tools/export/verify_parity.py reads its `names` list to assert class order.
#
# Intermediate ONNX builds are not — the shipped graph lives in public/models/
# under a content-hashed name.
/models/*.onnx

# ⚠ public/models/*.onnx IS COMMITTED ON PURPOSE, and must NOT be moved to
# Git LFS. Vercel does not resolve LFS pointers at build time: you would deploy
# a ~130-byte text file and the browser would fail with an opaque ONNX parse
# error. Commit the binary directly.

# ── Local export toolchain (see tools/export/README.md to recreate) ───────
tools/export/.venv/
tools/export/yolov5/
tools/export/out/
tools/export/*.onnx
# 2MB and regenerated in seconds by verify_parity.py; the JS tests only need
# raw.bin + expected.json, which ARE committed as test vectors.
tools/export/fixtures/*.input.bin

# ── Python (for legacy/ and the export tooling) ───────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── OS / editor ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# e2e screenshots
e2e/*.png
